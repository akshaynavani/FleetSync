# Generated by the Ansible deploy role -- do not edit. Pins image tags for this rollout
# on top of the committed overlay without modifying tracked files.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

resources:
  - ../../overlays/{{ env_name }}

images:
{% for svc in fleetsync_services %}
  - name: fleetsync/{{ svc }}
    newTag: "{{ image_tag }}"
{% endfor %}
